<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.jobpipeline</string>

    <key>WorkingDirectory</key>
    <string>/Users/justinpacubas/Documents/job_butler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/docker</string>
        <string>compose</string>
        <string>run</string>
        <string>--rm</string>
        <string>worker</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>2</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/jobpipeline.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jobpipeline.stderr.log</string>
</dict>
</plist>

