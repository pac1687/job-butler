# ============================================================================
# Job Butler — Worker & Shared Environment Configuration (.env)
# ============================================================================

# Neon PostgreSQL Connection String (Pooled or Direct TLS)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Host LM Studio Local Server Endpoint (from inside Docker container)
LM_STUDIO_BASE_URL="http://host.docker.internal:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MODEL="qwen2.5-7b-instruct"

# Embedding Model (Local Sentence Transformer)
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
CHROMA_PERSIST_DIR="/tmp/job_butler_chroma"

# Neon Object Storage (S3-Compatible Branch Storage)
# Found in Neon Console -> Project -> Connect -> Storage (or Object storage tab)
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-6.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="your-neon-storage-secret-key"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="job-artifacts"

# Worker Node Identity & Batch Tuning
WORKER_NODE_ID="macbook-pro-m1"
QUEUE_POLL_INTERVAL_SECONDS="10"
MAX_JOBS_PER_BATCH="5"


